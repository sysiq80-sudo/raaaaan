# ران RAAN — متغيرات البيئة
# انسخ هذا الملف إلى .env وعبّئ القيم

# ─── مطلوب (Required) ───────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ─── خرائط Google (مطلوب للخرائط) ───────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── تتبع الأخطاء (اختياري — Sentry) ────────────────────────
VITE_SENTRY_DSN=
VITE_APP_VERSION=1.0.0

# ─── Capacitor — عنوان IP للتطوير (اختياري) ──────────────────
# DEV_SERVER_IP=192.168.1.100

# ─── Transistorsoft BGGeo للسائق ─────────────────────────────
# اختياري: Authorization Token لخدمة Transistorsoft demo/tracker، وليس مفتاح الترخيص.
VITE_TRANSISTOR_BG_GEO_TOKEN=
# ترخيص Android الحقيقي لا يوضع في Vite. استخدم:
#   Production/CI: TRANSISTOR_BG_GEO_LICENSE=YOUR_LICENSE_KEY_JWT
#   Local Android: android/local.properties -> transistorBgGeoLicense=YOUR_LICENSE_KEY_JWT

# ─── Supabase CLI فقط (لا تستخدم VITE_) ─────────────────────
# SUPABASE_ACCESS_TOKEN=

# ─── Supabase Edge Functions (تُضبط عبر supabase secrets set) ───
# ALLOWED_ORIGINS=https://raan.app,https://admin.raan.app
# ENABLE_EXTERNAL_PAYMENT_GATEWAYS=false
