# ====================================
# Supabase Configuration - احصل على هذه القيم من لوحة تحكم Supabase
# ====================================
# 🔗 https://supabase.com/dashboard → Settings → API
# انسخ Project URL و anon/public key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ====================================
# Mapbox Configuration - احصل على token من Mapbox
# ====================================
# 🔗 https://account.mapbox.com/access-tokens/
# أنشئ token جديد أو استخدم الموجود

VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbGV4YW1wbGUifQ.your-mapbox-token-here

# ====================================
# API Configuration
# ====================================
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_ENVIRONMENT=development

# ====================================
# Feature Flags
# ====================================
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_LOGGING=true
VITE_DEBUG_MODE=false
