# ════════════════════════════════════════════════════════════════
# Keystore Properties — RAAN Android Release Signing
# ════════════════════════════════════════════════════════════════
# 
# كيفية الاستخدام:
# 1. انسخ هذا الملف إلى keystore.properties (بدون .example)
# 2. أنشئ ملف keystore بالأمر:
#    keytool -genkey -v -keystore raan-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias raan-alias
# 3. ضع ملف .jks في مجلد android/app/
# 4. عدّل القيم أدناه
#
# ⚠️ هذا الملف يحتوي أسرار — لا ترفعه على Git أبداً!
# ════════════════════════════════════════════════════════════════

storeFile=raan-release-key.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=raan-alias
keyPassword=YOUR_KEY_PASSWORD_HERE
