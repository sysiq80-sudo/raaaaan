<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RaanApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ═══ أيقونة إشعارات FCM الافتراضية ═══ -->
        <!-- الأيقونة: monochrome (أبيض/شفاف) — مطلوب لـ Android 5+ -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher_monochrome" />
        <!-- لون خلفية الأيقونة: أخضر ران -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_icon_color" />
    </application>

    <!-- ═══ Permissions ═══ -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الإشعارات — مطلوب صراحةً على Android 13+ (API 33) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- الاهتزاز للإشعارات -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- مراقبة حالة الشبكة -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الإشعارات المجدولة بعد إعادة التشغيل -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══ الموقع (GPS) — مطلوب للسائق والراكب ═══ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- تتبع الموقع بالخلفية — مطلوب لتطبيق السائق (Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ═══ الخدمة الأمامية — يمنع أندرويد من قتل التطبيق (شاومي/سامسونج) ═══ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- منع وضع السكون أثناء الرحلة النشطة -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- طلب تجاهل تحسينات البطارية (أجهزة شاومي/MIUI) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ═══ الكاميرا والمعرض — مطلوب لرفع وثائق KYC والصور ═══ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- للأندرويد أقل من 13 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

</manifest>
